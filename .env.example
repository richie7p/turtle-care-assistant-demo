APP_NAME=烏龜飼養小助手
APP_SHORT_NAME=烏龜飼養
APP_ICON=龜
APP_TAGLINE=懂你的龜，也懂你的飼養日常
APP_DESCRIPTION=結合龜龜 Profile、自訂飼養知識庫與 NVIDIA NIM 的完整實力示範。
ASSISTANT_NAME=烏龜飼養小助手
KNOWLEDGE_LABEL=飼養知識
PROFILE_LABEL=我的龜龜
WELCOME_TITLE=嗨！我是你的烏龜飼養小助手
WELCOME_DESCRIPTION=選擇一隻龜龜後提問，我會結合牠的資料與可信飼養知識回答。
APP_DISCLAIMER=AI 可能會出錯；重大健康問題請諮詢合格爬蟲類獸醫。
ENABLE_TURTLE_MODULE=true
KNOWLEDGE_DIR=./knowledge
SYSTEM_PROMPT_FILE=./prompts/assistant.md

APP_ENV=development
APP_ORIGIN=http://localhost:5173
SESSION_SECRET=請替換成至少32字元的隨機字串
SESSION_DAYS=7
DATABASE_URL=sqlite:///./data/turtle_assistant.db
UPLOAD_DIR=./uploads

AI_PROVIDER=nvidia-nim
AI_API_KEY=
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=nvidia/nemotron-3-nano-30b-a3b
AI_FALLBACK_MODEL=mistralai/mistral-nemotron
AI_VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl
AI_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-1b-v2
AI_TIMEOUT_SECONDS=45
AI_MAX_OUTPUT_TOKENS=1200
AI_INPUT_COST_PER_MILLION=
AI_OUTPUT_COST_PER_MILLION=

AI_REQUESTS_PER_MINUTE=10
AI_PER_USER_CONCURRENCY=1
AI_GLOBAL_CONCURRENCY=4
MAX_INPUT_CHARS=8000
MAX_IMAGE_BYTES=5242880
MAX_IMAGES_PER_MESSAGE=4
CONTEXT_RECENT_MESSAGES=12
CONTEXT_MAX_CHARS=40000
SUMMARY_TRIGGER_MESSAGES=20
RAG_TOP_K=4
RAG_MIN_SCORE=0.35

